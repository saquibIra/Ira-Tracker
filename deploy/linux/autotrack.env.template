# Production settings for the Autotrack service. install.sh copies this to
# /opt/timepilot-data/autotrack.env on first install. Edit the copy, then run
# `sudo /opt/time-pilot/deploy/linux/install.sh` again to apply.

# ---- AI: Gemini API key (https://aistudio.google.com -> Get API key) ----------------
TIMEPILOT_AI_PROVIDER=gemini
GEMINI_API_KEY=__GEMINI_API_KEY__
# Cheap model for every check; stronger model only when the first answer is unsure.
TIMEPILOT_AI_MODEL=gemini-3.5-flash-lite
TIMEPILOT_AI_ESCALATION_MODEL=gemini-3.8-flash
TIMEPILOT_AI_ESCALATE_BELOW=0.7
TIMEPILOT_AI_EFFORT=low
TIMEPILOT_AI_TIMEOUT_SECS=20
# Claude instead: TIMEPILOT_AI_PROVIDER=anthropic and ANTHROPIC_API_KEY=...

# ---- Auto-tracking policy sent to every widget --------------------------------------
# One screenshot every 5 minutes while tracking, kept only on the engineer's laptop.
TIMEPILOT_CAPTURE_INTERVAL_SECS=300
TIMEPILOT_KEEP_SCREENSHOTS_DAYS=3
TIMEPILOT_CAPTURE_MAX_PX=1568
TIMEPILOT_CAPTURE_QUALITY=60
# A new project must hold 2 minutes before the timer switches (backdated).
TIMEPILOT_MIN_SWITCH_SECS=120
# A project picked by hand is respected for 30 minutes.
TIMEPILOT_PIN_SECS=1800
# Below this confidence a block becomes "Needs review".
TIMEPILOT_REVIEW_BELOW=0.6
TIMEPILOT_UNRESOLVED_REVIEW_SECS=900
# No work hours: people track whenever they work. End-of-day review reminder, in each
# engineer's local time, on days with tracked time.
TIMEPILOT_REVIEW_AT=18:30
# TIMEPILOT_EXCLUDED_APPS=1Password,Bitwarden,KeePass,LastPass,Keychain Access,Passwords,Messages,Signal,Telegram,WhatsApp

# ---- Protection and logs ----------------------------------------------------------
TIMEPILOT_RATE_LIMIT_PER_HOUR=40
TIMEPILOT_LOG_LEVEL=INFO
