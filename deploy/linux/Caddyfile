{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Autotrack service (the prefix is removed before forwarding).
	handle_path /autotrack/* {
		reverse_proxy autotrack:8010
	}

	# Installers and update manifests for employees.
	handle_path /download/* {
		root * /srv/downloads
		file_server browse
	}

	# solidtime (web app and API).
	handle {
		reverse_proxy app:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format json
	}
}
