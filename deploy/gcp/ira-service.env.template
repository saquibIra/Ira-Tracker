# Production settings for the Ira service. bootstrap.sh copies this to
# /opt/ira-data/ira-service.env on first boot (filling in the project id). Edit the copy
# on the VM, then run update.sh to apply. All settings: server/ira-service/.env.example.

# ---- AI: Gemini on Vertex AI, using the VM's service account (no API key) ----------
IRA_AI_PROVIDER=gemini
GOOGLE_CLOUD_PROJECT=__PROJECT__
IRA_GEMINI_LOCATION=global
# Cheap model for every check; stronger model only when the first answer is unsure.
IRA_AI_MODEL=gemini-3.5-flash-lite
IRA_AI_ESCALATION_MODEL=gemini-3.8-flash
IRA_AI_ESCALATE_BELOW=0.7
IRA_AI_EFFORT=low
IRA_AI_TIMEOUT_SECS=20

# ---- Auto-tracking policy sent to every widget --------------------------------------
# One screenshot every 5 minutes while tracking, kept only on the engineer's laptop.
IRA_CAPTURE_INTERVAL_SECS=300
IRA_KEEP_SCREENSHOTS_DAYS=3
IRA_CAPTURE_MAX_PX=1568
IRA_CAPTURE_QUALITY=60
# A new project must hold 2 minutes before the timer switches (backdated).
IRA_MIN_SWITCH_SECS=120
# A project picked by hand is respected for 30 minutes.
IRA_PIN_SECS=1800
# Below this confidence a block becomes "Needs review".
IRA_REVIEW_BELOW=0.6
IRA_UNRESOLVED_REVIEW_SECS=900
# Work days (1 = Monday) and hours in each engineer's local time; review reminder.
IRA_WORK_DAYS=1,2,3,4,5
IRA_WORK_START=09:00
IRA_WORK_END=19:00
IRA_REVIEW_AT=18:30
# IRA_EXCLUDED_APPS=1Password,Bitwarden,KeePass,LastPass,Keychain Access,Passwords,Messages,Signal,Telegram,WhatsApp

# ---- Protection and logs ----------------------------------------------------------
IRA_RATE_LIMIT_PER_HOUR=40
IRA_LOG_LEVEL=INFO
