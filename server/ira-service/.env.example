# Ira service settings. Copy to `.env` (git-ignored) and fill in:
#   cp .env.example .env
# Only ANTHROPIC_API_KEY and SOLIDTIME_URL are required; everything else has a default.

# ---- Required ---------------------------------------------------------------

# AI provider: "gemini" (production on Google Cloud) or "anthropic".
#   gemini:    Vertex AI with GOOGLE_CLOUD_PROJECT (+ the VM's service account, or
#              `gcloud auth application-default login` locally), or GEMINI_API_KEY.
#   anthropic: ANTHROPIC_API_KEY (console.anthropic.com -> API Keys).
# Keys stay on the server; widgets never see them. Without AI, auto-tracking still
# works from keywords and learned windows.
IRA_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# IRA_GEMINI_LOCATION=global
# GEMINI_API_KEY=

# solidtime base URL as reachable from this service.
#   local run (uv):        http://localhost:8000
#   Docker (compose here): http://app:8000   (set automatically by docker-compose.yml)
SOLIDTIME_URL=http://localhost:8000

# ---- AI model (cheap first, stronger model only when unsure) -----------------

# Model that classifies every capture (default per provider: claude-haiku-5-5 /
# gemini-3.5-flash-lite). Leave unset to use the provider default.
# IRA_AI_MODEL=
# Model that re-checks answers below IRA_AI_ESCALATE_BELOW (default claude-opus-5-5 /
# gemini-3.8-flash). Set to empty for no re-check.
# IRA_AI_ESCALATION_MODEL=
IRA_AI_ESCALATE_BELOW=0.7
# low | medium | high | xhigh | max (low is plenty for "which project is this")
IRA_AI_EFFORT=low
IRA_AI_TIMEOUT_SECS=20
# Server-side refusal fallback on models that support it (Opus/Sonnet/Fable).
IRA_AI_REFUSAL_FALLBACK=true

# ---- Auto-tracking policy (sent to every widget) -----------------------------

# At most one screenshot per this many seconds (300 = 5 min, 600 = 10 min).
IRA_CAPTURE_INTERVAL_SECS=300
# A new project must hold this long before the timer switches (backdated).
IRA_MIN_SWITCH_SECS=120
# A project picked by hand is protected from auto-switching for this long.
IRA_PIN_SECS=1800
# Below this confidence a block is marked "Needs review" instead of a project.
IRA_REVIEW_BELOW=0.6
# Activity that stays unrecognised this long (e.g. offline) becomes "Needs review".
IRA_UNRESOLVED_REVIEW_SECS=900
# Screenshots are taken once per capture interval while tracking and kept ONLY on the
# engineer's own computer for this many days, so they can check their day in the
# review (0 = keep none; screenshots are then only taken when the AI needs one).
IRA_KEEP_SCREENSHOTS_DAYS=3
# Screenshot size: longest edge in pixels, JPEG quality (grayscale).
IRA_CAPTURE_MAX_PX=1568
IRA_CAPTURE_QUALITY=60
# Work days (1 = Monday ... 7 = Sunday) and hours, in each engineer's local time.
IRA_WORK_DAYS=1,2,3,4,5
IRA_WORK_START=09:00
IRA_WORK_END=19:00
# End-of-day review reminder (W8).
IRA_REVIEW_AT=18:30
# Apps that are never captured (comma separated, case-insensitive substring match).
# Leave unset for the built-in list (password managers, personal messengers).
# IRA_EXCLUDED_APPS=1Password,Bitwarden,KeePass,LastPass,Keychain Access,Passwords,Messages,Signal,Telegram,WhatsApp

# ---- Protection --------------------------------------------------------------

IRA_RATE_LIMIT_PER_HOUR=40
IRA_MAX_IMAGE_BYTES=900000

# Logs: DEBUG | INFO | WARNING | ERROR; format text (local) or json (Cloud Logging).
IRA_LOG_LEVEL=INFO
IRA_LOG_FORMAT=text

# SQLite file for project hints, usage log and day submissions.
IRA_DB_PATH=ira-service.db
